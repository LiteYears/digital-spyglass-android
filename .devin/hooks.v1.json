{
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/pre_exec_guard.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/post_exec_log.py",
          "timeout": 3
        }
      ]
    },
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/post_edit_lint.py",
          "timeout": 12
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/session_start.py",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/user_prompt_submit.py",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python .devin/hooks/stop_guard.py",
          "timeout": 2
        },
        {
          "type": "command",
          "command": "python .devin/hooks/pre_completion_check.py",
          "timeout": 2
        }
      ]
    }
  ]
}
