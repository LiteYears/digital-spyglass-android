# Normalize line endings: LF in repo, OS-native in working tree.
# This prevents CRLF/LF mismatches between Windows checkouts and Prettier.
* text=auto eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.apk binary
*.jks binary
*.keystore binary
