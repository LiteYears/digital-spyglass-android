<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Nothing this app stores may ever leave the
  device through Google Drive backup or device-to-device transfer: the vault,
  the WebView cache and the Keystore aliases are all excluded wholesale.
  Combined with android:allowBackup="false" this is belt and braces.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
