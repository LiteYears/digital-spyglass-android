<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to android/app/src/main/res/xml/network_security_config.xml after `npx cap add android`
  and reference it from AndroidManifest.xml:
      <application android:networkSecurityConfig="@xml/network_security_config" ... >

  Cleartext is denied globally. The app does not use Android's HTTP stack for
  Tor traffic — all onion requests go through raw SOCKS5 sockets in the native
  Tor plugin, which is not affected by this flag. The Capacitor WebView loads
  via androidScheme="https" (https://localhost). User-installed CAs are never
  trusted (blocks casual MITM).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
