{
  "name": "darknetcrawler-mobile",
  "license": "GPL-3.0-or-later",
  "author": "Joerg Bollwahn <sookoothaii@proton.me>",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "Hardened Android client for the DarkNetCrawler OSINT backend",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run build:mobile && npx cap sync android",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/react-virtual": "3.14.9",
    "@tanstack/router-plugin": "1.168.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "linkedom": "0.18.13",
    "lucide-react": "0.575.0",
    "openpgp": "6.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socks-proxy-agent": "10.1.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite-tsconfig-paths": "6.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "9.39.5",
    "@lovable.dev/vite-tanstack-config": "2.15.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fast-check": "4.10.2",
    "globals": "15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "5.0.5"
  }
}
